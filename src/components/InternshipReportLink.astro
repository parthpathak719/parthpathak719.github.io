---
interface Props { href: string; title: string; meta: string; }
const { href, title, meta } = Astro.props;
---
<a class="internship-report-link" href={href} target="_blank" rel="noopener noreferrer">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>
  <span class="internship-report-label"><strong>{title}</strong><small>{meta}</small></span>
  <span class="internship-report-arrow" aria-hidden="true">↗</span>
</a>
