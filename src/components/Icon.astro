---
import BrandIcon from './BrandIcon.astro';
interface Props { name: 'github' | 'linkedin' | 'email'; }
const { name } = Astro.props;
---
<span class="social-icon" aria-hidden="true">
  {name === 'github' && <BrandIcon name="github" collection="simple" size={17} />}
  {name === 'linkedin' && <BrandIcon name="linkedin-icon" size={17} />}
  {name === 'email' && <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m3.5 6 8.5 6.5L20.5 6" /></svg>}
</span>
