---
import BrandIcon from './BrandIcon.astro';
import { certificates } from '../data/credentials';
const entries = [
  { title: 'Cloud Foundations', provider: 'AWS Academy', href: certificates.cloudFoundations, icon: 'aws' },
  { title: 'Cloud Practitioner Essentials', provider: 'AWS Training & Certification', href: certificates.cloudPractitioner, icon: 'aws' },
  { title: 'Introduction to Modern AI', provider: 'Cisco', href: certificates.modernAI, icon: 'cisco' },
  { title: 'Agile Scrum Master', provider: 'Simplilearn', href: certificates.agile, icon: 'simplilearn' },
  { title: 'Introduction to Jira', provider: 'Simplilearn', href: certificates.jira, icon: 'jira' },
];
---
<div class="credentials-showcase" aria-labelledby="credentials-title">
  <div class="credentials-heading"><h3 id="credentials-title">Courses & credentials</h3></div>
  <div class="credentials-grid">
    {entries.map(entry => <a class="credential-card" href={entry.href} target="_blank" rel="noopener noreferrer">
      <div class:list={['credential-icon', { 'credential-wordmark': entry.icon === 'simplilearn' }]} aria-hidden="true">
        {entry.icon === 'aws' && <BrandIcon name="amazonwebservices" collection="simple" size={28} color="#ffac43" />}
        {entry.icon === 'jira' && <BrandIcon name="jira" size={26} />}
        {entry.icon === 'cisco' && <BrandIcon name="cisco" collection="simple" size={30} color="#72c4ee" />}
        {entry.icon === 'simplilearn' && <span>Simplilearn</span>}
      </div>
      <div><span class="credential-provider">{entry.provider}</span><h4>{entry.title}</h4></div>
      <div class="credential-action"><span>View certificate</span><span aria-hidden="true">↗</span></div>
    </a>)}
  </div>
</div>
